# TokenPilot local development. Nothing here is a secret; copy values from your shell.
TOKENPILOT_LOCAL_TOKEN=
MODEL_API_KEY=
TOKENPILOT_UPSTREAM_BASE_URL=https://api.meta.ai/v1
TOKENPILOT_UPSTREAM_PROVIDER=meta
TOKENPILOT_INVESTIGATOR_MODEL=muse-spark-1.3-contributor
# Leave empty to use the default (~/.tokenpilot/tokenpilot.sqlite3); the app
# ignores empty values here, and refuses to boot without a local token.
TOKENPILOT_DB_PATH=
TOKENPILOT_STORE_CONTENT=false
TOKENPILOT_ALLOW_CONTENT_TRANSMISSION=false
TOKENPILOT_API_URL=http://127.0.0.1:8787
