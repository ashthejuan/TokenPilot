                      },
                      "input_tokens": {
                        "anyOf": [
                          {
                            "minimum": 0,
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Input Tokens"
                      },
                      "latency_ms": {
